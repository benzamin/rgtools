---
// src/components/SiteHeader.astro
// Thin, shared title bar used across the homepage and every tool page.
import logo from '../assets/redgreen-logo.png';
import coffeeImage from '../assets/buy-me-a-cofee.png';
const { image } = Astro.props;
---

<header class="site-header">
  <a class="brand" href="/">
    <img src={logo.src ?? logo} alt="RedGreen Studio logo" class="brand-logo" width="32" height="32" />
    <span class="brand-name">
      <span class="brand-red">RED</span><span class="brand-green">GREEN</span><span class="brand-studio"> Studio</span>
    </span>
  </a>

  
  <a class="coffee-link" href="https://www.buymeacoffee.com/benzamin" target="_blank"><img src="https://cdn.buymeacoffee.com/buttons/v2/default-yellow.png" alt="Buy Me a Coffee"  ></a>  

  <nav class="quick-links" aria-label="Quick links">
    <a href="/json/">JSON</a>
    <a href="/diff/">DIFF</a>
    <a href="/base64/">BASE64</a>
    <a href="/jwt/">JWT</a>
    <a href="/qr/">QR</a>
  </nav>

  <div class="header-controls">
    <nav class="site-nav" id="site-nav">
      <div class="nav-item has-dropdown">
        <button class="nav-link dropdown-trigger" aria-haspopup="true" aria-expanded="false">
          Apps
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="dropdown-menu">
          <a href="/json/" class="dropdown-link">
            <strong>JSON Viewer</strong>
            <span>View, validate &amp; edit JSON</span>
          </a>
          <a href="/diff/" class="dropdown-link">
            <strong>Diff Checker</strong>
            <span>Compare text &amp; export to PDF</span>
          </a>
          <a href="/base64/" class="dropdown-link">
            <strong>Base64 Utility</strong>
            <span>Encode &amp; decode text</span>
          </a>
          <a href="/qr/" class="dropdown-link">
            <strong>QR Generator</strong>
            <span>Generate QR codes from text</span>
          </a>
          <a href="/jwt/" class="dropdown-link">
            <strong>JWT Utility</strong>
            <span>Decode &amp; verify tokens locally</span>
          </a>
        </div>
      </div>
      <a class="nav-link" href="/pricing/">Pricing</a>
      <a class="nav-link" href="/about/">About Us</a>
      <a class="nav-link" href="/feedback/">Feedback</a>
    </nav>

    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Toggle navigation">
      <span></span><span></span><span></span>
    </button>

    <button class="theme-toggle" type="button" aria-label="Switch to light mode" title="Switch theme" data-theme-toggle>
      <svg class="theme-toggle-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 4V2M12 22v-2M4 12H2M22 12h-2M5.64 5.64 4.22 4.22M19.78 19.78l-1.42-1.42M18.36 5.64l1.42-1.42M4.22 19.78l1.42-1.42M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <svg class="theme-toggle-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M20.5 15.5A8.5 8.5 0 0 1 8.5 3.5 8.5 8.5 0 1 0 20.5 15.5Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 56px;
    padding: 0 1.25rem;
    background: var(--background, #0a0a0a);
    border-bottom: 1px solid var(--border, #262626);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    line-height: 1;
    flex-shrink: 0;
  }

  .brand-logo {
    width: 32px;
    height: 32px;
    object-fit: contain;
    display: block;
  }

  .brand-name {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .brand-red { color: var(--green, #16a34a); }
  .brand-green { color: var(--red, #dc2626); }
  .brand-studio { color: var(--foreground, #ededed); font-weight: 600; }

  .coffee-link {
    display: inline-flex;
    align-items: center;
    flex: 0 0 120px;
    width: 220px;
    margin-left: 30px;
    padding: 0.25rem;
  }

  .coffee-link img {
    display: block;
    width: 100%;
    height: auto;
  }

  .header-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  .quick-links {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.3rem;
    max-width: calc(100% - 25rem);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .quick-links::-webkit-scrollbar {
    display: none;
  }

  .quick-links a {
    flex: 0 0 auto;
    padding: 0.3rem 0.55rem;
    color: var(--foreground, #ededed);
    border: 1px solid var(--border, #262626);
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .quick-links a:hover {
    background: var(--muted, #171717);
    border-color: var(--muted-foreground, #a3a3a3);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-item.has-dropdown {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.75rem;
    color: var(--foreground, #ededed);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    border-radius: 6px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }

  .nav-link:hover {
    background: var(--muted, #171717);
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    background: var(--surface, #171717);
    border: 1px solid var(--border, #262626);
    border-radius: 10px;
    padding: 0.4rem;
    display: none;
    flex-direction: column;
    gap: 0.15rem;
    box-shadow: 0 12px 30px var(--shadow, rgba(0, 0, 0, 0.4));
  }

  .has-dropdown:hover .dropdown-menu,
  .has-dropdown.open .dropdown-menu {
    display: flex;
  }

  .dropdown-link {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.55rem 0.7rem;
    border-radius: 6px;
    text-decoration: none;
    color: var(--foreground, #ededed);
  }

  .dropdown-link:hover {
    background: var(--muted, #262626);
  }

  .dropdown-link strong {
    font-size: 0.88rem;
  }

  .dropdown-link span {
    font-size: 0.76rem;
    color: var(--muted-foreground, #a3a3a3);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 34px;
    height: 34px;
    background: transparent;
    border: 1px solid var(--border, #262626);
    border-radius: 6px;
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    height: 2px;
    margin: 0 6px;
    background: var(--foreground, #ededed);
    border-radius: 1px;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--foreground, #ededed);
    background: transparent;
    border: 1px solid var(--border, #262626);
    border-radius: 999px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    background: var(--muted, #171717);
  }

  .theme-toggle-sun {
    display: none;
  }

  :global(:root[data-theme='light']) .theme-toggle-sun {
    display: block;
  }

  :global(:root[data-theme='light']) .theme-toggle-moon {
    display: none;
  }

  @media (max-width: 720px) {
    .quick-links {
      position: static;
      transform: none;
      flex: 1;
      justify-content: flex-start;
      min-width: 0;
      max-width: none;
    }

    .nav-toggle {
      display: flex;
    }

    .site-nav {
      position: absolute;
      top: 56px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      background: var(--background, #0a0a0a);
      border-bottom: 1px solid var(--border, #262626);
      padding: 0.5rem;
      display: none;
    }

    .site-nav.open {
      display: flex;
    }

    .dropdown-menu {
      position: static;
      display: none;
      border: none;
      box-shadow: none;
      padding-left: 0.5rem;
    }

    .has-dropdown.open .dropdown-menu {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(!!isOpen));
  });

  document.querySelectorAll('.dropdown-trigger').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const item = btn.closest('.has-dropdown');
      const isOpen = item?.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(!!isOpen));
    });
  });

  const storageKey = 'redgreen-theme';
  const themeToggle = document.querySelector('[data-theme-toggle]');
  const isTheme = (value) => value === 'light' || value === 'dark';

  const applyTheme = (theme) => {
    document.documentElement.dataset.theme = theme;
    themeToggle?.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
  };

  if (themeToggle) {
    applyTheme(isTheme(document.documentElement.dataset.theme) ? document.documentElement.dataset.theme : 'dark');
    themeToggle.addEventListener('click', () => {
      const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      applyTheme(nextTheme);
      try {
        localStorage.setItem(storageKey, nextTheme);
      } catch (error) {
        console.warn('Could not save theme preference.', error);
      }
    });
  }
</script>
