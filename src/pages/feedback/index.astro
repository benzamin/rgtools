---
// src/pages/feedback/index.astro
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout title="Feedback | RedGreen Studio" description="Send feedback to the RedGreen Studio team.">
  <section class="feedback">
    <h1>Send us feedback</h1>
    <p>Found a bug, have a feature request, or just want to say hi? Send us a message.</p>

    <form class="feedback-form" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value="035e8e00-7080-4807-8818-7eff5a6f7b1d" />
      <label>
        Your name
        <input type="text" name="name" placeholder="Jane Doe" required />
      </label>
      <label>
        Your email
        <input type="email" name="email" placeholder="jane@example.com" required />
      </label>
      <label>
        Message
        <textarea name="message" rows="6" placeholder="Tell us what's on your mind..." required></textarea>
      </label>
      <button type="submit" class="submit-btn">Send Feedback</button>
    </form>
  </section>
</PageLayout>

<style>
  .feedback {
    max-width: 640px;
    margin: 0 auto;
    padding: 4rem 1.5rem 5rem;
  }

  .feedback h1 {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .feedback > p {
    color: var(--muted-foreground);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .feedback-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .feedback-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .feedback-form input,
  .feedback-form textarea {
    font: inherit;
    padding: 0.65rem 0.8rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--muted);
    color: var(--foreground);
    resize: vertical;
  }

  .feedback-form input:focus,
  .feedback-form textarea:focus {
    outline: 2px solid var(--green);
    outline-offset: 1px;
  }

  .submit-btn {
    align-self: flex-start;
    padding: 0.7rem 1.4rem;
    border-radius: 8px;
    border: none;
    background: var(--green);
    color: var(--button-foreground);
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
  }

  .submit-btn:hover {
    opacity: 0.85;
  }
</style>
