---
// src/pages/diff-finder/index.astro
import DiffViewer from '../../components/DiffViewer.jsx';
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout title="Online JSON & Text Diff Finder | Client-Side Tool" description="Compare two JSON objects or text files side-by-side entirely in your browser. Fast, free, and secure.">
  <div class="diff-page">
    <!-- <header class="diff-header">
      <h1>Diff Finder &amp; Comparator</h1>
      <p>Compare two text snippets or JSON files. No data is sent to external servers.</p>
    </header> -->

    <div class="diff-body">
      {/* Astro hydrates this interactive element dynamically on load */}
      <DiffViewer client:load />
    </div>
  </div>
</PageLayout>

<style>
  .diff-page {
    width: 100%;
    margin: 0;
    padding: 2rem 1rem;
  }

  .diff-header {
    margin-bottom: 2rem;
  }

  .diff-header h1 {
    margin: 0 0 0.5rem;
    font-size: 1.75rem;
  }

  .diff-header p {
    color: var(--muted-foreground);
    margin: 0;
  }
</style>
